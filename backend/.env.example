# Copy to .env and fill in. The API works with no Firebase config (local JSON fallback).
# Must match the proxy target in frontend/vite.config.js.
PORT=5057

# Set NODE_ENV=production on the live server so localhost origins are rejected.
# NODE_ENV=production
# Extra allowed browser origins besides bixabotanical.in (comma-separated), e.g. the myshopify domain:
# CORS_ORIGINS=https://your-store.myshopify.com

# Firestore credentials (optional) - use ONE of these options:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_PROJECT_ID=bixa-product-finder
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
